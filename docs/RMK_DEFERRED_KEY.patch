2. 修改 process_key_action_inner 函数，在菜单拦截检查之前添加延迟按键检查：

```rust
async fn process_key_action_inner(&mut self, original_key_action: &KeyAction, event: KeyboardEvent) {
    // Start forks
    let key_action = self.try_start_forks(original_key_action, event);

    // Clear with_modifier if a new key is pressed
    if self.with_modifiers.into_bits() != 0 && event.pressed {
        self.with_modifiers = ModifierCombination::new();
    }

    #[cfg(feature = "_ble")]
    LAST_KEY_TIMESTAMP.signal(Instant::now().as_secs() as u32);

    #[cfg(feature = "controller")]
    publish_controller_event(KeyEvent {
        keyboard_event: event,
        key_action,
    });

    // ====== 延迟按键检查 ======
    // 延迟按键始终被拦截，但 KeyEvent 已发布给控制器
    #[cfg(feature = "controller")]
    {
        if let KeyboardEventPos::Key(KeyPos { row, col }) = event.pos {
            if is_deferred_key(row, col) {
                // 延迟按键：控制器会决定是否发送
                self.try_finish_forks(original_key_action, event);
                return;
            }
        }
    }
    // ====== 延迟按键检查结束 ======

    // ====== 菜单拦截检查 ======
    #[cfg(feature = "controller")]
    {
        let should_intercept = match event.pos {
            KeyboardEventPos::Key(KeyPos { row, col }) => should_intercept_key(row, col),
            KeyboardEventPos::RotaryEncoder(_) => should_intercept_encoder(),
        };
        if should_intercept {
            self.try_finish_forks(original_key_action, event);
            return;
        }
    }
    // ====== 菜单拦截结束 ======

    // ... 原有的按键处理代码 ...
}
```

